PORT=3000
# Origine du front autorisée (CORS)
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_dungeon_key_change_me
# Base locale (docker compose) ; en prod : Neon, DATABASE_URL avec pooling et DIRECT_URL sans
DATABASE_URL="postgresql://admin:password123@localhost:5432/dungeon_desk_db?schema=public"
DIRECT_URL="postgresql://admin:password123@localhost:5432/dungeon_desk_db?schema=public"
# Auth0 : API (audience) et tenant (issuer, avec la barre finale)
AUTH0_AUDIENCE=https://dungeon-desk-api
AUTH0_ISSUER=https://votre-tenant.eu.auth0.com/
# Seed : connexions simultanées à la base (facultatif, défaut 4)
SEED_POOL_SIZE=4
