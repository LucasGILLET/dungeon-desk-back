generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Rôle dans le back-office des données de jeu
enum UserRole {
  USER // joueur : aucun accès au back-office
  TRANSLATOR // modifie uniquement les traductions
  EDITOR // modifie le contenu et les traductions
  ADMIN
}

model User {
  id                    Int            @id @default(autoincrement())
  username              String?        @unique
  email                 String         @unique
  password              String?
  auth0Id               String?        @unique
  role                  UserRole       @default(USER)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  npcs                  Npc[]
  characters            Character[]
  // Contenu maison créé par l'utilisateur (ownerId des tables SRD)
  homebrewLanguages     Language[]
  homebrewEquipment     Equipment[]
  homebrewClasses       Class[]
  homebrewSubclasses    Subclass[]
  homebrewClassFeatures ClassFeature[]
  homebrewSpells        Spell[]
}

model Npc {
  id        Int      @id @default(autoincrement())
  name      String
  race      String
  class     String?
  data      Json
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String
  race      String
  class     String
  level     Int
  data      Json
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
