// ============================================================================
// HISTORIQUES ET DONS (rattachés à une édition)
// ----------------------------------------------------------------------------
// 2014 : l'historique donne des maîtrises, des langues, de l'équipement, une
// aptitude narrative et des tables de personnalité. Le SRD ne contient qu'un
// historique (Acolyte) et qu'un don (Lutteur) ; les 12 historiques de
// custom/custom-backgrounds.json sont importés comme contenu maison.
// Les ajouts 2024 (caractéristiques augmentables, don d'origine, catégories
// de dons) viendront avec cette édition.
// ============================================================================

model Background {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id])
  index     String // "acolyte"

  source    ContentSource @default(SRD)
  ownerId   Int?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations       BackgroundTranslation[]
  proficiencies      BackgroundProficiency[]
  startingEquipment  BackgroundStartingEquipment[]
  personalityOptions BackgroundPersonalityOption[]
  choices            Choice[] // langues au choix, équipement au choix (dont une somme en po)

  // Personnages qui l'utilisent
  characters Character[]

  @@unique([editionId, index])
}

model BackgroundTranslation {
  id                 Int        @id @default(autoincrement())
  backgroundId       Int
  localeCode         String
  name               String // "Acolyte"
  // Aptitude d'historique : "Abri du fidèle"
  featureName        String?
  featureDescription String?    @db.Text
  background         Background @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  locale             Locale     @relation(fields: [localeCode], references: [code])

  @@unique([backgroundId, localeCode])
}

model BackgroundProficiency {
  id            Int         @id @default(autoincrement())
  backgroundId  Int
  proficiencyId Int
  background    Background  @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  proficiency   Proficiency @relation(fields: [proficiencyId], references: [id])

  @@unique([backgroundId, proficiencyId])
}

model BackgroundStartingEquipment {
  id           Int        @id @default(autoincrement())
  backgroundId Int
  equipmentId  Int
  quantity     Int        @default(1)
  background   Background @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  equipment    Equipment  @relation(fields: [equipmentId], references: [id])

  @@unique([backgroundId, equipmentId])
}

// Tables de personnalité (2014). Le nombre à choisir (2 traits, 1 idéal,
// 1 lien, 1 défaut) est une règle fixe de l'édition.
enum PersonalityKind {
  PERSONALITY_TRAIT
  IDEAL
  BOND
  FLAW
}

model BackgroundPersonalityOption {
  id           Int             @id @default(autoincrement())
  backgroundId Int
  background   Background      @relation(fields: [backgroundId], references: [id], onDelete: Cascade)
  kind         PersonalityKind
  position     Int // valeur du dé (d8 pour les traits, d6 pour le reste)

  translations PersonalityOptionTranslation[]
  alignments   PersonalityOptionAlignment[] // idéaux : alignements associés

  // Personnages qui l'utilisent
  characters CharacterPersonality[]

  @@unique([backgroundId, kind, position])
}

model PersonalityOptionTranslation {
  id         Int                         @id @default(autoincrement())
  optionId   Int
  localeCode String
  text       String                      @db.Text
  option     BackgroundPersonalityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  locale     Locale                      @relation(fields: [localeCode], references: [code])

  @@unique([optionId, localeCode])
}

model PersonalityOptionAlignment {
  id          Int                         @id @default(autoincrement())
  optionId    Int
  alignmentId Int
  option      BackgroundPersonalityOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  alignment   Alignment                   @relation(fields: [alignmentId], references: [id])

  @@unique([optionId, alignmentId])
}

// ----------------------------------------------------------------------------
// Dons
// ----------------------------------------------------------------------------

model Feat {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id])
  index     String // "grappler"

  source    ContentSource @default(SRD)
  ownerId   Int?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations  FeatTranslation[]
  prerequisites FeatPrerequisite[]

  // Personnages qui l'utilisent
  characterLevels CharacterLevel[]

  @@unique([editionId, index])
}

model FeatTranslation {
  id          Int    @id @default(autoincrement())
  featId      Int
  localeCode  String
  name        String // "Lutteur"
  description String @db.Text
  feat        Feat   @relation(fields: [featId], references: [id], onDelete: Cascade)
  locale      Locale @relation(fields: [localeCode], references: [code])

  @@unique([featId, localeCode])
}

// Prérequis de caractéristique (Lutteur : FOR 13). Même logique que
// MulticlassRequirement : même groupe = OU, groupes différents = ET. Les autres
// types de prérequis (niveau, maîtrise, race…) viendront avec les dons 2024.
model FeatPrerequisite {
  id               Int          @id @default(autoincrement())
  featId           Int
  feat             Feat         @relation(fields: [featId], references: [id], onDelete: Cascade)
  abilityScoreId   Int
  abilityScore     AbilityScore @relation(fields: [abilityScoreId], references: [id])
  minimumScore     Int
  alternativeGroup Int          @default(1)
}
