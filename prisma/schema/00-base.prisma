// ============================================================================
// Socle des données de jeu (SRD) : base commune
// ----------------------------------------------------------------------------
// Le schéma est réparti en un fichier par domaine (00 à 12 ; les domaines à venir sont dans
// docs/modelisation/brouillons) ; schema.prisma
// contient le générateur, la source de données et les modèles applicatifs.
// Conventions complémentaires (nommage, CHECK, seed, API) :
// docs/modelisation/conventions.md
//
// Conventions appliquées dans tous les fichiers :
//
//  1. Clés : `id` autoincrémenté = clé technique ; `index` (slug anglais,
//     ex. "wizard") = clé métier stable, neutre en langue. Toutes les tables,
//     y compris traductions et liaisons, ont une clé primaire `id` simple
//     (exigé par Directus) ; l'ancienne clé composée devient un @@unique.
//     Une clé primaire n'est jamais aussi une clé étrangère (tables 1-1 comme
//     WeaponStats : `id` + `equipmentId @unique`), sinon Directus ne suit pas
//     les relations au-delà d'un niveau.
//
//  2. Éditions : tout contenu de jeu porte `editionId`, avec l'unicité
//     @@unique([editionId, index]). Le magicien 2014 et le magicien 2024 sont
//     deux lignes distinctes. Seuls quelques référentiels universels (les six
//     caractéristiques, les compétences, les alignements, les types de dégâts,
//     les écoles de magie, les types de créatures, les terrains) sont partagés
//     entre éditions et n'ont pas de `editionId`.
//
//  3. Traductions : l'entité ne contient que des données neutres en langue
//     (nombres, références, enums). Tout texte lisible est dans une table
//     `<Entité>Translation` (clé [entitéId, localeCode]). Côté API : langue
//     demandée, puis repli sur la langue par défaut.
//
//  4. JSONB : uniquement pour des valeurs neutres en langue appartenant à un
//     seul parent (vitesses, sens, montée en puissance des dégâts…). Chaque
//     colonne JSONB est validée par un schéma Zod partagé front/back (le type
//     attendu est indiqué en commentaire). Jamais de texte en JSONB.
//
//  5. Contenu maison : tout contenu modifiable porte `source` (SRD / HOMEBREW)
//     et `ownerId` → User (null = contenu global ; mis à null si l'utilisateur
//     est supprimé). L'application suffixe l'`index` du contenu maison pour éviter les
//     collisions entre utilisateurs.
//
//  6. Unités : distances en pieds, poids en livres, prix en pièces. La
//     conversion (1,5 m pour 5 pieds, kg) est faite à l'affichage selon la
//     langue : les données françaises actuelles stockent "18 mètres" en texte.
//
//  7. Les enums servent aux listes techniques fixées par les règles (tailles,
//     unités…), traduites par le front (i18n). Les listes de contenu,
//     éditables dans le back-office, sont des tables.
//
//  8. Une contrainte « exactement une colonne cible remplie » (références
//     polymorphes) est signalée par CHECK : à écrire en SQL brut dans la
//     migration, ex. CHECK (num_nonnulls(a, b, c) = 1).
//
// 9. Les textes longs sont en Markdown (`@db.Text`).
// ============================================================================

enum ContentSource {
  SRD
  HOMEBREW
}

enum Size {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

enum Currency {
  CP // pièce de cuivre
  SP // pièce d'argent
  EP // pièce d'électrum
  GP // pièce d'or
  PP // pièce de platine
}

model Locale {
  code                            String                           @id // "fr", "en"
  name                            String // nom dans sa propre langue : "Français", "English"
  isDefault                       Boolean                          @default(false) // langue de repli (une seule)
  position                        Int
  editionTranslations             EditionTranslation[]
  abilityScoreTranslations        AbilityScoreTranslation[]
  skillTranslations               SkillTranslation[]
  alignmentTranslations           AlignmentTranslation[]
  damageTypeTranslations          DamageTypeTranslation[]
  magicSchoolTranslations         MagicSchoolTranslation[]
  creatureTypeTranslations        CreatureTypeTranslation[]
  terrainTranslations             TerrainTranslation[]
  conditionTranslations           ConditionTranslation[]
  languageTranslations            LanguageTranslation[]
  proficiencyTranslations         ProficiencyTranslation[]
  equipmentCategoryTranslations   EquipmentCategoryTranslation[]
  equipmentTranslations           EquipmentTranslation[]
  weaponPropertyTranslations      WeaponPropertyTranslation[]
  choiceTranslations              ChoiceTranslation[]
  classTranslations               ClassTranslation[]
  classTableColumnTranslations    ClassTableColumnTranslation[]
  spellcastingSectionTranslations SpellcastingSectionTranslation[]
  subclassTranslations            SubclassTranslation[]
  classFeatureTranslations        ClassFeatureTranslation[]
  spellTranslations               SpellTranslation[]
  raceTranslations                RaceTranslation[]
  subraceTranslations             SubraceTranslation[]
  traitTranslations               TraitTranslation[]
  backgroundTranslations          BackgroundTranslation[]
  personalityOptionTranslations   PersonalityOptionTranslation[]
  featTranslations                FeatTranslation[]

  npcTableEntryTranslations         NpcTableEntryTranslation[]
  creatureSubtypeTranslations       CreatureSubtypeTranslation[]
  monsterTranslations               MonsterTranslation[]
  monsterDamageModifierTranslations MonsterDamageModifierTranslation[]
  monsterActionTranslations         MonsterActionTranslation[]
  magicItemTranslations             MagicItemTranslation[]
  monsterArmorClassTranslations     MonsterArmorClassTranslation[]
  ruleChapterTranslations           RuleChapterTranslation[]
  ruleSectionTranslations           RuleSectionTranslation[]
  guidePageTranslations             GuidePageTranslation[]
  guideSectionTranslations          GuideSectionTranslation[]
  guideCardTranslations             GuideCardTranslation[]
  guideCardListTranslations         GuideCardListTranslation[]
}

model Edition {
  id          Int     @id @default(autoincrement())
  code        String  @unique // "2014", "2024"
  releaseYear Int
  isDefault   Boolean @default(false)
  position    Int

  // Règles de création des caractéristiques (identiques en 2014 et 2024, mais
  // propres à l'édition). JSONB neutres en langue, validés par Zod.
  pointBuyBudget Int  @default(27)
  // { "8": 0, "9": 1, …, "15": 9 } : coût de chaque valeur
  pointBuyCosts  Json @default("{\"8\":0,\"9\":1,\"10\":2,\"11\":3,\"12\":4,\"13\":5,\"14\":7,\"15\":9}")
  // [15, 14, 13, 12, 10, 8]
  standardArray  Json @default("[15,14,13,12,10,8]")

  translations        EditionTranslation[]
  conditions          Condition[]
  languages           Language[]
  proficiencies       Proficiency[]
  equipmentCategories EquipmentCategory[]
  equipment           Equipment[]
  weaponProperties    WeaponProperty[]
  classes             Class[]
  subclasses          Subclass[]
  classFeatures       ClassFeature[]
  spells              Spell[]
  races               Race[]
  subraces            Subrace[]
  traits              Trait[]
  backgrounds         Background[]
  feats               Feat[]

  // Personnages qui l'utilisent
  characters Character[]

  // PNJ qui l'utilisent
  npcs         Npc[]
  monsters     Monster[]
  magicItems   MagicItem[]
  ruleChapters RuleChapter[]
  ruleSections RuleSection[]
  guidePages   GuidePage[]
}

model EditionTranslation {
  id          Int     @id @default(autoincrement())
  editionId   Int
  localeCode  String
  name        String // "D&D 5e (2014)", "D&D 5e révisé (2024)"
  // Mention d'attribution obligatoire (SRD 5.1 et 5.2 sous CC-BY-4.0)
  attribution String  @db.Text
  edition     Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  locale      Locale  @relation(fields: [localeCode], references: [code])

  @@unique([editionId, localeCode])
}
