// ============================================================================
// RACES, SOUS-RACES ET TRAITS (rattachés à une édition)
// ----------------------------------------------------------------------------
// Un seul modèle `Race` pour les deux éditions : le libellé "Race" / "Espèce"
// relève de l'interface. En 2024 il n'y aura simplement pas de bonus de
// caractéristiques, et les lignées seront des traits enfants choisis via un
// Choice SUBFEATURE.
// Sources 2014 : 5e-SRD-Races, -Subraces, -Traits, et les fichiers custom
// (sous-races et traits supplémentaires, importés comme contenu maison).
// ============================================================================

model Race {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id])
  index     String // "dwarf"
  // JSONB Sizes : tailles possibles, ["MEDIUM"], ou ["SMALL", "MEDIUM"] pour
  // l'humain 2024 (JSON plutôt qu'un tableau d'enum : éditable dans Directus)
  sizes     Json
  // JSONB Speeds : { walk: 25, fly?, swim?, climb?, burrow? } (pieds)
  speeds    Json

  source    ContentSource @default(SRD)
  ownerId   Int?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations RaceTranslation[]
  abilityBonus RaceAbilityBonus[]
  languages    RaceLanguage[]
  traits       RaceTrait[]
  subraces     Subrace[]
  choices      Choice[] // langue au choix, bonus au choix (demi-elfe)

  // Personnages qui l'utilisent
  characters Character[]

  @@unique([editionId, index])
}

model RaceTranslation {
  id            Int     @id @default(autoincrement())
  raceId        Int
  localeCode    String
  name          String // "Nain"
  // Textes descriptifs du SRD 2014
  ageText       String? @db.Text
  alignmentText String? @db.Text
  sizeText      String? @db.Text
  languageText  String? @db.Text
  race          Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)
  locale        Locale  @relation(fields: [localeCode], references: [code])

  @@unique([raceId, localeCode])
}

// Bonus fixes (2014) : nain +2 CON
model RaceAbilityBonus {
  id             Int          @id @default(autoincrement())
  raceId         Int
  abilityScoreId Int
  bonus          Int
  race           Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  abilityScore   AbilityScore @relation(fields: [abilityScoreId], references: [id])

  @@unique([raceId, abilityScoreId])
}

model RaceLanguage {
  id         Int      @id @default(autoincrement())
  raceId     Int
  languageId Int
  race       Race     @relation(fields: [raceId], references: [id], onDelete: Cascade)
  language   Language @relation(fields: [languageId], references: [id])

  @@unique([raceId, languageId])
}

model RaceTrait {
  id      Int   @id @default(autoincrement())
  raceId  Int
  traitId Int
  race    Race  @relation(fields: [raceId], references: [id], onDelete: Cascade)
  trait   Trait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([raceId, traitId])
}

// ----------------------------------------------------------------------------
// Sous-races (2014)
// ----------------------------------------------------------------------------

model Subrace {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id])
  index     String // "hill-dwarf"
  raceId    Int
  race      Race    @relation(fields: [raceId], references: [id], onDelete: Cascade)

  source    ContentSource @default(SRD)
  ownerId   Int?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations SubraceTranslation[]
  abilityBonus SubraceAbilityBonus[]
  traits       SubraceTrait[]
  choices      Choice[]

  // Personnages qui l'utilisent
  characters Character[]

  @@unique([editionId, index])
}

model SubraceTranslation {
  id          Int     @id @default(autoincrement())
  subraceId   Int
  localeCode  String
  name        String // "Nain des collines"
  description String? @db.Text
  subrace     Subrace @relation(fields: [subraceId], references: [id], onDelete: Cascade)
  locale      Locale  @relation(fields: [localeCode], references: [code])

  @@unique([subraceId, localeCode])
}

model SubraceAbilityBonus {
  id             Int          @id @default(autoincrement())
  subraceId      Int
  abilityScoreId Int
  bonus          Int
  subrace        Subrace      @relation(fields: [subraceId], references: [id], onDelete: Cascade)
  abilityScore   AbilityScore @relation(fields: [abilityScoreId], references: [id])

  @@unique([subraceId, abilityScoreId])
}

model SubraceTrait {
  id        Int     @id @default(autoincrement())
  subraceId Int
  traitId   Int
  subrace   Subrace @relation(fields: [subraceId], references: [id], onDelete: Cascade)
  trait     Trait   @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([subraceId, traitId])
}

// ----------------------------------------------------------------------------
// Traits raciaux (partagés entre races : vision dans le noir…)
// ----------------------------------------------------------------------------

model Trait {
  id        Int     @id @default(autoincrement())
  editionId Int
  edition   Edition @relation(fields: [editionId], references: [id])
  index     String // "darkvision", "draconic-ancestry-red"
  // Trait enfant : "Ascendance draconique (rouge)" → "Ascendance draconique"
  parentId  Int?
  parent    Trait?  @relation("TraitTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Trait[] @relation("TraitTree")

  // Type de dégâts associé (ascendance draconique)
  damageTypeId Int?
  damageType   DamageType? @relation(fields: [damageTypeId], references: [id])
  // JSONB TraitAction, pour un trait utilisable comme une action (souffle du
  // drakéide) : { area, save, damageAtCharacterLevel, usage }
  action       Json?

  source    ContentSource @default(SRD)
  ownerId   Int?
  owner     User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  translations  TraitTranslation[]
  races         RaceTrait[]
  subraces      SubraceTrait[]
  proficiencies TraitProficiency[]
  choices       Choice[] // maîtrise au choix, langue, tour de magie, sous-trait
  choiceItems   ChoiceOptionItem[] @relation("ChoiceItemTrait")

  // Personnages qui l'utilisent
  characterUsage CharacterFeatureUsage[]

  @@unique([editionId, index])
}

model TraitTranslation {
  id          Int    @id @default(autoincrement())
  traitId     Int
  localeCode  String
  name        String // "Vision dans le noir"
  description String @db.Text
  trait       Trait  @relation(fields: [traitId], references: [id], onDelete: Cascade)
  locale      Locale @relation(fields: [localeCode], references: [code])

  @@unique([traitId, localeCode])
}

model TraitProficiency {
  id            Int         @id @default(autoincrement())
  traitId       Int
  proficiencyId Int
  trait         Trait       @relation(fields: [traitId], references: [id], onDelete: Cascade)
  proficiency   Proficiency @relation(fields: [proficiencyId], references: [id])

  @@unique([traitId, proficiencyId])
}
