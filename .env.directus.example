# Secrets du Directus local (copier en .env.directus, non versionné).
# Générer des valeurs aléatoires, par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Jeton d'API de l'admin (scripts de configuration), facultatif
ADMIN_TOKEN=
# Clé de licence (Open Innovation Grant), format DXXXX-XXXXX-XXXXX-XXXXC.
# Elle est liée au PUBLIC_URL de l'instance (http://localhost:8055 en local) :
# chaque PUBLIC_URL consomme une activation (5 au total). Avant de détruire une
# instance, désactiver la licence dans Paramètres → Licence pour libérer l'activation.
LICENSE_KEY=
