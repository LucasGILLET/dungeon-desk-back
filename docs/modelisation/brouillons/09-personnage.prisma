// ============================================================================
// APERÇU — Personnage (étape 7 de la feuille de route, non modélisé ici)
// ----------------------------------------------------------------------------
// Le personnage ne stockera plus de copies d'objets SRD dans `data` mais des
// références, ce qui permet au backend de tout valider :
//
// model Character {
//   id           Int
//   userId       Int
//   editionId    Int            // tout le contenu référencé vient de cette édition
//   name         String
//   raceId       Int
//   subraceId    Int?
//   backgroundId Int
//   abilities    → 6 colonnes (valeurs de base, avant bonus)
//   classes      CharacterClass[]
//   choices      CharacterChoice[]
//   …
// }
//
// model CharacterClass {             // une ligne par classe → multiclassage natif
//   characterId Int
//   classId     Int
//   subclassId  Int?
//   level       Int
//   position    Int                  // classe de départ = 1
//   @@id([characterId, classId])
// }
//
// model CharacterChoice {            // ce que le joueur a choisi
//   characterId Int
//   choiceId    Int
//   optionId    Int?                 // option listée
//   // ou élément d'une réserve (Choice.pool) : languageId, spellId, featId…
// }
//
// Validations possibles côté serveur : l'option appartient bien au choix, le
// nombre d'options = Choice.choose, le niveau de classe permet la capacité,
// tous les contenus viennent de la même édition (ou mélange autorisé).
// ============================================================================
