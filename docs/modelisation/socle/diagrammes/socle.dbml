// Socle des données de jeu (SRD) — dungeon-desk — BROUILLON
// Généré depuis docs/modelisation/socle/*.prisma (ne pas éditer à la main).
// Relations vers Locale (tables *Translation) et Edition (contenu de jeu)
// omises pour la lisibilité : voir les colonnes localeCode / editionId.

Enum ContentSource {
  SRD
  HOMEBREW
}

Enum Size {
  TINY
  SMALL
  MEDIUM
  LARGE
  HUGE
  GARGANTUAN
}

Enum Currency {
  CP
  SP
  EP
  GP
  PP
}

Enum AlignmentEthic {
  LAWFUL
  NEUTRAL
  CHAOTIC
}

Enum AlignmentMorality {
  GOOD
  NEUTRAL
  EVIL
}

Enum LanguageRarity {
  STANDARD
  EXOTIC
  RARE
  SECRET
}

Enum ProficiencyType {
  SKILL
  SAVING_THROW
  ARMOR
  WEAPON
  ARTISAN_TOOL
  MUSICAL_INSTRUMENT
  GAMING_SET
  VEHICLE
  OTHER
}

Enum EquipmentKind {
  WEAPON
  ARMOR
  ADVENTURING_GEAR
  AMMUNITION
  TOOL
  MOUNT
  VEHICLE
  PACK
  FOCUS
}

Enum WeaponCategory {
  SIMPLE
  MARTIAL
}

Enum WeaponRange {
  MELEE
  RANGED
}

Enum ArmorCategory {
  LIGHT
  MEDIUM
  HEAVY
  SHIELD
}

Enum VehicleSpeedUnit {
  FEET_PER_ROUND
  MILES_PER_HOUR
}

Enum ChoiceKind {
  PROFICIENCY
  MULTICLASS_PROFICIENCY
  EXPERTISE
  LANGUAGE
  STARTING_EQUIPMENT
  ABILITY_SCORE_INCREASE
  SPELL
  SUBFEATURE
  FAVORED_ENEMY
  FAVORED_TERRAIN
}

Enum ChoicePool {
  EQUIPMENT_CATEGORY
  ANY_LANGUAGE
}

Enum ClassColumnValueType {
  INTEGER
  DICE
  BOOLEAN
}

Enum CasterType {
  FULL
  HALF
  THIRD
  PACT
}

Enum ClassFeaturePrerequisiteType {
  LEVEL
  FEATURE
  SPELL
}

Enum PersonalityKind {
  PERSONALITY_TRAIT
  IDEAL
  BOND
  FLAW
}

Enum CastingTimeUnit {
  ACTION
  BONUS_ACTION
  REACTION
  MINUTE
  HOUR
}

Enum SpellRangeType {
  SELF
  TOUCH
  DISTANCE
  SIGHT
  UNLIMITED
  SPECIAL
}

Enum SpellDurationType {
  INSTANTANEOUS
  ROUND
  MINUTE
  HOUR
  DAY
  UNTIL_DISPELLED
  SPECIAL
}

Enum AttackType {
  MELEE
  RANGED
}

Enum SaveSuccess {
  NONE
  HALF
  OTHER
}

Enum AreaType {
  CONE
  CUBE
  CYLINDER
  LINE
  SPHERE
  EMANATION
}

Table Locale {
  code varchar [pk, note: '"fr", "en"']
  name varchar [not null, note: 'nom dans sa propre langue : "Français", "English"']
  isDefault boolean [not null, default: false, note: 'langue de repli (une seule)']
  position int [not null]
  Note: 'Relations vers Locale non dessinées (référencée par presque toutes les tables).'
}

Table Edition {
  id int [pk, increment]
  code varchar [unique, not null, note: '"2014", "2024"']
  releaseYear int [not null]
  isDefault boolean [not null, default: false]
  position int [not null]
  Note: 'Relations vers Edition non dessinées (référencée par presque toutes les tables).'
}

Table EditionTranslation {
  id int [pk, increment]
  editionId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"D&D 5e (2014)", "D&D 5e révisé (2024)"']
  attribution varchar [not null]
  indexes {
    (editionId, localeCode) [unique]
  }
}

Table AbilityScore {
  id int [pk, increment]
  index varchar [unique, not null, note: '"str"']
  position int [not null, note: 'ordre d\'affichage FOR, DEX, CON, INT, SAG, CHA']
}

Table AbilityScoreTranslation {
  id int [pk, increment]
  abilityScoreId int [not null]
  localeCode varchar [not null]
  abbreviation varchar [not null, note: '"FOR" / "STR"']
  name varchar [not null, note: '"Force" / "Strength"']
  description varchar
  indexes {
    (abilityScoreId, localeCode) [unique]
  }
}

Table Skill {
  id int [pk, increment]
  index varchar [unique, not null, note: '"arcana"']
  abilityScoreId int [not null]
}

Table SkillTranslation {
  id int [pk, increment]
  skillId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Arcanes"']
  description varchar
  indexes {
    (skillId, localeCode) [unique]
  }
}

Table Alignment {
  id int [pk, increment]
  index varchar [unique, not null, note: '"lawful-good"']
  ethic AlignmentEthic [not null]
  morality AlignmentMorality [not null]
}

Table AlignmentTranslation {
  id int [pk, increment]
  alignmentId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Loyal bon"']
  abbreviation varchar [not null, note: '"LB" / "LG"']
  description varchar
  indexes {
    (alignmentId, localeCode) [unique]
  }
}

Table DamageType {
  id int [pk, increment]
  index varchar [unique, not null, note: '"fire"']
}

Table DamageTypeTranslation {
  id int [pk, increment]
  damageTypeId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Feu"']
  description varchar
  indexes {
    (damageTypeId, localeCode) [unique]
  }
}

Table MagicSchool {
  id int [pk, increment]
  index varchar [unique, not null, note: '"evocation"']
}

Table MagicSchoolTranslation {
  id int [pk, increment]
  magicSchoolId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Évocation"']
  description varchar
  indexes {
    (magicSchoolId, localeCode) [unique]
  }
}

Table CreatureType {
  id int [pk, increment]
  index varchar [unique, not null, note: '"dragon", "undead"']
}

Table CreatureTypeTranslation {
  id int [pk, increment]
  creatureTypeId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Dragon", "Mort-vivant"']
  pluralName varchar [not null, note: '"Dragons", "Morts-vivants" (ennemi juré du rôdeur)']
  indexes {
    (creatureTypeId, localeCode) [unique]
  }
}

Table Terrain {
  id int [pk, increment]
  index varchar [unique, not null, note: '"arctic"']
}

Table TerrainTranslation {
  id int [pk, increment]
  terrainId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Arctique"']
  indexes {
    (terrainId, localeCode) [unique]
  }
}

Table Condition {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"blinded"']
  indexes {
    (editionId, index) [unique]
  }
}

Table ConditionTranslation {
  id int [pk, increment]
  conditionId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Aveuglé"']
  description varchar [not null]
  indexes {
    (conditionId, localeCode) [unique]
  }
}

Table Language {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"dwarvish"']
  rarity LanguageRarity [not null]
  scriptId int
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table LanguageTranslation {
  id int [pk, increment]
  languageId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Nain"']
  typicalSpeakers varchar [note: '"Nains"']
  description varchar
  indexes {
    (languageId, localeCode) [unique]
  }
}

Table Proficiency {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null]
  type ProficiencyType [not null]
  skillId int
  abilityScoreId int
  equipmentId int
  equipmentCategoryId int
  indexes {
    (editionId, index) [unique]
  }
}

Table ProficiencyTranslation {
  id int [pk, increment]
  proficiencyId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Armures légères"']
  indexes {
    (proficiencyId, localeCode) [unique]
  }
}

Table EquipmentCategory {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"simple-melee-weapons", "holy-symbols"']
  parentId int
  indexes {
    (editionId, index) [unique]
  }
}

Table EquipmentCategoryTranslation {
  id int [pk, increment]
  equipmentCategoryId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Armes courantes de corps à corps"']
  indexes {
    (equipmentCategoryId, localeCode) [unique]
  }
}

Table Equipment {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"longsword"']
  kind EquipmentKind [not null]
  costAmount int
  costCurrency Currency
  weightLb decimal
  bundleSize int [not null, default: 1]
  imageUrl varchar
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table EquipmentTranslation {
  id int [pk, increment]
  equipmentId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Épée longue"']
  description varchar
  indexes {
    (equipmentId, localeCode) [unique]
  }
}

Table EquipmentCategoryItem {
  id int [pk, increment]
  equipmentId int [not null]
  categoryId int [not null]
  indexes {
    (equipmentId, categoryId) [unique]
  }
}

Table PackContent {
  id int [pk, increment]
  packId int [not null]
  itemId int [not null]
  quantity int [not null, default: 1]
  indexes {
    (packId, itemId) [unique]
  }
}

Table WeaponStats {
  id int [pk, increment]
  equipmentId int [unique, not null]
  category WeaponCategory [not null]
  range WeaponRange [not null]
  damageDice varchar
  damageTypeId int
  versatileDice varchar [note: 'dégâts à deux mains (propriété Polyvalente)']
  normalRangeFt int [note: 'portée normale (armes à distance et de lancer)']
  longRangeFt int
}

Table WeaponProperty {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"finesse", "versatile"']
  indexes {
    (editionId, index) [unique]
  }
}

Table WeaponPropertyTranslation {
  id int [pk, increment]
  weaponPropertyId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Finesse"']
  description varchar [not null]
  indexes {
    (weaponPropertyId, localeCode) [unique]
  }
}

Table WeaponStatsProperty {
  id int [pk, increment]
  weaponId int [not null]
  propertyId int [not null]
  indexes {
    (weaponId, propertyId) [unique]
  }
}

Table ArmorStats {
  id int [pk, increment]
  equipmentId int [unique, not null]
  category ArmorCategory [not null]
  baseArmorClass int [not null, note: '11, ou +2 pour un bouclier']
  addsDexModifier boolean [not null]
  maxDexModifier int [note: '2 pour les armures intermédiaires']
  strengthMinimum int
  stealthDisadvantage boolean [not null, default: false]
}

Table VehicleStats {
  id int [pk, increment]
  equipmentId int [unique, not null]
  speed decimal
  speedUnit VehicleSpeedUnit
  capacityLb int
}

Table Choice {
  id int [pk, increment]
  kind ChoiceKind [not null]
  choose int [not null]
  classId int
  subclassId int
  classFeatureId int
  raceId int
  subraceId int
  traitId int
  backgroundId int
  parentOptionId int [unique, note: 'sous-choix d\'une option']
  pool ChoicePool
  poolCategoryId int
}

Table ChoiceTranslation {
  id int [pk, increment]
  choiceId int [not null]
  localeCode varchar [not null]
  description varchar [not null, note: '"Choisissez deux compétences parmi Arcanes, Histoire…"']
  indexes {
    (choiceId, localeCode) [unique]
  }
}

Table ChoiceOption {
  id int [pk, increment]
  choiceId int [not null]
  position int [not null]
}

Table ChoiceOptionItem {
  id int [pk, increment]
  optionId int [not null]
  quantity int [not null, default: 1, note: '20 flèches']
  bonus int [note: '+1 / +2 pour une augmentation de caractéristique']
  proficiencyId int
  equipmentId int
  equipmentCategoryId int [note: '"une arme de guerre au choix" dans un lot']
  classFeatureId int
  creatureTypeId int
  terrainId int
  languageId int
  abilityScoreId int
  spellId int
  traitId int
  currencyAmount int
  currency Currency
}

Table Class {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"wizard"']
  hitDie int [not null, note: '6 → d6']
  subclassLevel int [not null]
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table ClassTranslation {
  id int [pk, increment]
  classId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Magicien"']
  description varchar
  subclassLabel varchar [not null]
  indexes {
    (classId, localeCode) [unique]
  }
}

Table ClassPrimaryAbility {
  id int [pk, increment]
  classId int [not null]
  abilityScoreId int [not null]
  indexes {
    (classId, abilityScoreId) [unique]
  }
}

Table ClassSavingThrow {
  id int [pk, increment]
  classId int [not null]
  abilityScoreId int [not null]
  indexes {
    (classId, abilityScoreId) [unique]
  }
}

Table ClassProficiency {
  id int [pk, increment]
  classId int [not null]
  proficiencyId int [not null]
  indexes {
    (classId, proficiencyId) [unique]
  }
}

Table ClassStartingEquipment {
  id int [pk, increment]
  classId int [not null]
  equipmentId int [not null]
  quantity int [not null, default: 1]
  indexes {
    (classId, equipmentId) [unique]
  }
}

Table ClassLevel {
  id int [pk, increment]
  classId int [not null]
  level int [not null, note: '1..20']
  abilityScoreImprovements int [not null, default: 0]
  cantripsKnown int
  spellsKnown int [note: 'sorts connus (barde, ensorceleur, occultiste, rôdeur 2014)']
  indexes {
    (classId, level) [unique]
  }
}

Table ClassLevelSpellSlot {
  id int [pk, increment]
  classLevelId int [not null]
  spellLevel int [not null, note: '1..9']
  slots int [not null]
  indexes {
    (classLevelId, spellLevel) [unique]
  }
}

Table ClassTableColumn {
  id int [pk, increment]
  classId int [not null]
  subclassId int [note: 'colonne ajoutée par une sous-classe']
  key varchar [not null, note: '"rage_count" (clé du SRD, utilisée par le code)']
  valueType ClassColumnValueType [not null]
  position int [not null]
  indexes {
    (classId, key) [unique]
  }
}

Table ClassTableColumnTranslation {
  id int [pk, increment]
  columnId int [not null]
  localeCode varchar [not null]
  label varchar [not null, note: '"Rages"']
  indexes {
    (columnId, localeCode) [unique]
  }
}

Table ClassLevelValue {
  id int [pk, increment]
  classLevelId int [not null]
  columnId int [not null]
  intValue int
  diceCount int
  diceValue int
  boolValue boolean
  indexes {
    (classLevelId, columnId) [unique]
  }
}

Table ClassSpellcasting {
  id int [pk, increment]
  classId int [unique, not null]
  abilityScoreId int [not null]
  startLevel int [not null, note: '1 ou 2']
  casterType CasterType [not null]
  ritualCasting boolean [not null, default: false]
}

Table SpellcastingSection {
  id int [pk, increment]
  spellcastingId int [not null]
  position int [not null]
}

Table SpellcastingSectionTranslation {
  id int [pk, increment]
  sectionId int [not null]
  localeCode varchar [not null]
  title varchar [not null, note: '"Tours de magie"']
  description varchar [not null]
  indexes {
    (sectionId, localeCode) [unique]
  }
}

Table ClassSpell {
  id int [pk, increment]
  classId int [not null]
  spellId int [not null]
  indexes {
    (classId, spellId) [unique]
  }
}

Table MulticlassRequirement {
  id int [pk, increment]
  classId int [not null]
  abilityScoreId int [not null]
  minimumScore int [not null, default: 13]
  alternativeGroup int [not null, default: 1]
}

Table ClassMulticlassProficiency {
  id int [pk, increment]
  classId int [not null]
  proficiencyId int [not null]
  indexes {
    (classId, proficiencyId) [unique]
  }
}

Table Subclass {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"evocation"']
  classId int [not null]
  casterType CasterType
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table SubclassTranslation {
  id int [pk, increment]
  subclassId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"École d\'évocation"']
  description varchar
  indexes {
    (subclassId, localeCode) [unique]
  }
}

Table SubclassSpell {
  id int [pk, increment]
  subclassId int [not null]
  spellId int [not null]
  requiredClassLevel int [not null]
  requiredFeatureId int
  indexes {
    (subclassId, spellId, requiredFeatureId) [unique]
  }
}

Table ClassFeature {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"arcane-recovery"']
  level int [not null, note: 'niveau de classe d\'obtention']
  classId int [not null]
  subclassId int [note: 'null = capacité commune à la classe']
  parentId int
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table ClassFeatureTranslation {
  id int [pk, increment]
  classFeatureId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Restauration arcanique"']
  description varchar [not null]
  indexes {
    (classFeatureId, localeCode) [unique]
  }
}

Table ClassFeaturePrerequisite {
  id int [pk, increment]
  classFeatureId int [not null]
  type ClassFeaturePrerequisiteType [not null]
  minimumLevel int
  requiredFeatureId int
  requiredSpellId int
}

Table Race {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"dwarf"']
  sizes jsonb [not null]
  speeds jsonb [not null]
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table RaceTranslation {
  id int [pk, increment]
  raceId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Nain"']
  ageText varchar
  alignmentText varchar
  sizeText varchar
  languageText varchar
  indexes {
    (raceId, localeCode) [unique]
  }
}

Table RaceAbilityBonus {
  id int [pk, increment]
  raceId int [not null]
  abilityScoreId int [not null]
  bonus int [not null]
  indexes {
    (raceId, abilityScoreId) [unique]
  }
}

Table RaceLanguage {
  id int [pk, increment]
  raceId int [not null]
  languageId int [not null]
  indexes {
    (raceId, languageId) [unique]
  }
}

Table RaceTrait {
  id int [pk, increment]
  raceId int [not null]
  traitId int [not null]
  indexes {
    (raceId, traitId) [unique]
  }
}

Table Subrace {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"hill-dwarf"']
  raceId int [not null]
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table SubraceTranslation {
  id int [pk, increment]
  subraceId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Nain des collines"']
  description varchar
  indexes {
    (subraceId, localeCode) [unique]
  }
}

Table SubraceAbilityBonus {
  id int [pk, increment]
  subraceId int [not null]
  abilityScoreId int [not null]
  bonus int [not null]
  indexes {
    (subraceId, abilityScoreId) [unique]
  }
}

Table SubraceTrait {
  id int [pk, increment]
  subraceId int [not null]
  traitId int [not null]
  indexes {
    (subraceId, traitId) [unique]
  }
}

Table Trait {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"darkvision", "draconic-ancestry-red"']
  parentId int
  damageTypeId int
  action jsonb
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table TraitTranslation {
  id int [pk, increment]
  traitId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Vision dans le noir"']
  description varchar [not null]
  indexes {
    (traitId, localeCode) [unique]
  }
}

Table TraitProficiency {
  id int [pk, increment]
  traitId int [not null]
  proficiencyId int [not null]
  indexes {
    (traitId, proficiencyId) [unique]
  }
}

Table Background {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"acolyte"']
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table BackgroundTranslation {
  id int [pk, increment]
  backgroundId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Acolyte"']
  featureName varchar
  featureDescription varchar
  indexes {
    (backgroundId, localeCode) [unique]
  }
}

Table BackgroundProficiency {
  id int [pk, increment]
  backgroundId int [not null]
  proficiencyId int [not null]
  indexes {
    (backgroundId, proficiencyId) [unique]
  }
}

Table BackgroundStartingEquipment {
  id int [pk, increment]
  backgroundId int [not null]
  equipmentId int [not null]
  quantity int [not null, default: 1]
  indexes {
    (backgroundId, equipmentId) [unique]
  }
}

Table BackgroundPersonalityOption {
  id int [pk, increment]
  backgroundId int [not null]
  kind PersonalityKind [not null]
  position int [not null, note: 'valeur du dé (d8 pour les traits, d6 pour le reste)']
}

Table PersonalityOptionTranslation {
  id int [pk, increment]
  optionId int [not null]
  localeCode varchar [not null]
  text varchar [not null]
  indexes {
    (optionId, localeCode) [unique]
  }
}

Table PersonalityOptionAlignment {
  id int [pk, increment]
  optionId int [not null]
  alignmentId int [not null]
  indexes {
    (optionId, alignmentId) [unique]
  }
}

Table Feat {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"grappler"']
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table FeatTranslation {
  id int [pk, increment]
  featId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Lutteur"']
  description varchar [not null]
  indexes {
    (featId, localeCode) [unique]
  }
}

Table FeatPrerequisite {
  id int [pk, increment]
  featId int [not null]
  abilityScoreId int [not null]
  minimumScore int [not null]
  alternativeGroup int [not null, default: 1]
}

Table Spell {
  id int [pk, increment]
  editionId int [not null]
  index varchar [not null, note: '"fireball"']
  level int [not null, note: '0 = tour de magie']
  schoolId int [not null]
  castingTimeAmount int [not null, default: 1]
  castingTimeUnit CastingTimeUnit [not null]
  ritual boolean [not null, default: false]
  rangeType SpellRangeType [not null]
  rangeFt int
  verbal boolean [not null, default: false]
  somatic boolean [not null, default: false]
  material boolean [not null, default: false]
  materialCostGp decimal [note: 'composante avec un coût']
  materialConsumed boolean [not null, default: false]
  durationType SpellDurationType [not null]
  durationAmount int
  concentration boolean [not null, default: false]
  attackType AttackType
  saveAbilityId int
  saveSuccess SaveSuccess
  areaType AreaType
  areaSizeFt int
  damageScaling jsonb
  healingScaling jsonb
  source ContentSource [not null, default: 'SRD']
  ownerId int
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
  indexes {
    (editionId, index) [unique]
  }
}

Table SpellTranslation {
  id int [pk, increment]
  spellId int [not null]
  localeCode varchar [not null]
  name varchar [not null, note: '"Boule de feu"']
  description varchar [not null]
  higherLevels varchar [note: '"Aux niveaux supérieurs"']
  materialText varchar [note: '"une minuscule boule de guano de chauve-souris et du soufre"']
  castingTimeNote varchar [note: 'déclencheur : "que vous effectuez lorsque…"']
  rangeNote varchar [note: 'précisions de portée ou de durée SPECIAL']
  indexes {
    (spellId, localeCode) [unique]
  }
}

Table SpellDamageType {
  id int [pk, increment]
  spellId int [not null]
  damageTypeId int [not null]
  indexes {
    (spellId, damageTypeId) [unique]
  }
}

