  id int [pk, increment]
  questId int [not null]
  campaignNpcId int [not null]
  indexes {
    (questId, campaignNpcId) [unique]
    campaignNpcId
  }
}

Table Encounter {
  id int [pk, increment]
  campaignId int [not null]
  sessionId int
  position int [not null]
  name varchar [not null]
  description varchar [note: 'Markdown']
  status EncounterStatus [not null, default: 'PLANNED']
  createdAt timestamp [not null, default: `now()`]
  updatedAt timestamp [not null]
}

Table EncounterMonster {
  id int [pk, increment]
  encounterId int [not null]
  monsterId int [not null]
  count int [not null]
  indexes {
    (encounterId, monsterId) [unique]
  }
}

